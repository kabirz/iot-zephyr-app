/ {
	chosen {
		zephyr,canbus = &can1;
		zephyr,settings-partition = &cfg_partition;
		zephyr,display = &sh1106_sh1106_128x64;
	};

	zephyr,user {
		canpower-gpios = <&gpioc 7 GPIO_ACTIVE_HIGH>;
		dispower-gpios = <&gpioc 8 GPIO_ACTIVE_HIGH>;
		handlerpower-gpios = <&gpioa 8 GPIO_ACTIVE_HIGH>;

		handlebt-gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>;

		chargefull-gpios = <&gpioa 3 GPIO_PULL_UP>;
		charging-gpios = <&gpioa 2 GPIO_PULL_UP>;
		power-gpios = <&gpioa 1 GPIO_PULL_UP>;
		linksw-gpios = <&gpioa 10 GPIO_PULL_UP>;

		io-channels = <&adc1 14>, <&adc1 15>, <&adc2 9>;
		io-channel-names = "adc_x", "adc_y", "adc_vcc";
	};
};

&spi2 {
	pinctrl-0 = <&spi2_sck_master_pb13
		     &spi2_miso_master_pb14
		     &spi2_mosi_master_pb15>;
	pinctrl-names = "default";
	cs-gpios = <&gpiob 12 GPIO_ACTIVE_LOW>;
	status = "okay";

	nrf24: nrf24l01p@0 {
		compatible = "nordic,nrf24l01p";
		reg = <0x0>;
		spi-max-frequency = <8000000>;
		ce-gpios = <&gpioa 9 GPIO_ACTIVE_HIGH>;
		irq-gpios = <&gpioc 6 GPIO_ACTIVE_LOW>;
		power-gpios = <&gpioc 9 GPIO_ACTIVE_HIGH>;
		channel = <1>;
		data-rate = "1m";
		tx-power = "0dbm";
		/* 半双工冲突优化: 缩短单次 TX 最坏占用 (ARD×ARC), 让冲突后更快切回
		 * PRX 给对端 ACK 机会. ARD=1500us + ARC=9 → 最坏 ~13.5ms (默认 4ms×15=60ms). */
		ard-us = <1500>;
		arc = <9>;
	};
};

&can1 {
	pinctrl-0 = <&can_rx_pa11 &can_tx_pa12>;
	pinctrl-names = "default";
	status = "okay";
};

&adc1 {
    status = "okay";
    pinctrl-0 = <&adc1_in14_pc4 &adc1_in15_pc5 &adc1_in9_pb1>;
    pinctrl-names = "default";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@e {
        reg = <14>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };

    channel@f {
        reg = <15>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };


};
&adc2 {
    status = "okay";
    pinctrl-0 = <&adc2_in9_pb1>;
    pinctrl-names = "default";
    #address-cells = <1>;
    #size-cells = <0>;
    channel@9 {
        reg = <9>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };
};

&rtc {
    clocks = <&rcc STM32_CLOCK_BUS_APB1 0x10000000>,
             <&rcc STM32_SRC_LSI RTC_SEL(2)>;
    status = "okay";
};

/* OLED 显示 (SH1106 @ 0x3C, I2C2, 400kHz 快速模式) */
&i2c2 {
	clock-frequency = <400000>;
	pinctrl-0 = <&i2c2_scl_pb10 &i2c2_sda_pb11>;
	pinctrl-1 = <&analog_pb11 &analog_pb11>;
	pinctrl-names = "default", "sleep";
	status = "okay";

	sh1106_sh1106_128x64: ssd1306@3c {
		compatible = "sinowealth,sh1106";
		reg = <0x3c>;
		width = <128>;
		height = <64>;
		segment-offset = <2>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		segment-remap;
		com-invdir;
		prechargep = <0x22>;
		ready-time-ms = <100>;
	};
};

/* PM 低功耗状态: 外设电源由应用层 system_sleep/system_wake 管理 (GPIO 断电),
 * PM 子系统进 STOP 时挂起设备 (I2C2 经 sleep pinctrl 切 analog 释放总线,
 * 唤醒后自动恢复) —— 防止 OLED 断电期间 I2C 总线被拉低卡死、唤醒后无法恢复。 */
&stop0 {
};

&stop1 {
};
