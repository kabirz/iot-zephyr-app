# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files
*.c text
*.h text
*.py text
*.sh text
*.cmake text
*.txt text
*.md text
*.conf text
*.cfg text
*.ini text
*.yml text
*.yaml text
*.ld text
*.dts text
*.dtsi text
*.overlay text
*.Kconfig text
*Kconfig* text

# Declare files that will always have CRLF line endings on checkout
*.bat text eol=crlf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.bin binary
*.hex binary
*.elf binary
*.o binary
*.a binary
*.so binary
*.zip binary
*.gz binary
*.tar binary
*.pdf binary

# Shell scripts must use LF
*.sh eol=lf
*.py eol=lf

# Make scripts executable
*.sh -diff
*.py -diff

# PEM key files
*.pem text
