 *
 * RT-Thread Titan Mini board (Renesas RA8P1, R7KA8P1KFLCAC, CM85 core)
 * Schematic: Titan_Mini HW V1.0
 *  - Debug UART on U18 (RPi 40-pin header, pins 8/10): SCI1,
 *      TXD1 = P707, RXD1 = P706
 *  - Secondary UART on header H1: SCI2, TXD2 = P801, RXD2 = P802
 *  - RGB user LED (XL-1615RGBC-RF, common anode, active low):
 *      R = P109, G = P108, B = P110
 *  - Main crystal 24 MHz (EXTAL/XTAL), sub crystal 32.768 kHz (XCIN/XCOUT)
 *  - SWD debug on J6 (SWDIO = P210, SWCLK = P211)
 *  - SD card on SDHI0 (PD01/02/03/04/05/07, DAT3 = P111)
 *  - IMU LSM6DS3TR-C on IIC1 (SDA1 = P511, SCL1 = P512), addr 0x6A,
 *    INT1 = P412 (IMU_INT1)
 *  - Gigabit Ethernet: RTL8211F-CG PHY on eth1 (RGMII1), MDIO = PC11/PC12,
 *    PHY addr 0x01, reset = PA07, interrupt = P107, 25 MHz xtal on PHY
 *  - RGB LCD (ATK-MD0700R-1024600, RGB565) on GLCDC/lcdif, BL = P303,
 *    LCD_RST = P011; 触摸 GT911 on IIC0 (SDA0=P409, SCL0=P410),
 *    CTP_RST = P412, CTP_IRQ_N = P007
 *  - SDRAM W9825G6KH-6 (32 MB, 16-bit) at 0x68000000
 *  - QSPI NOR flash W25Q64JVSSIQ (8 MB) on OSPI-B/XSPI0 channel 0, CS1
 */

/dts-v1/;

#include <renesas/ra/ra8/r7ka8p1kflcac_cm85.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/flash_controller/xspi.h>
#include <zephyr/dt-bindings/memory-controller/renesas,ra-sdram.h>
#include <zephyr/dt-bindings/memory-attr/memory-attr-arm.h>
#include <zephyr/dt-bindings/flash_controller/xspi.h>
#include "titan_mini-pinctrl.dtsi"

/ {
	model = "RT-Thread Titan Mini (RA8P1)";
	compatible = "renesas,ra8p1", "renesas,ra8";

	soc {
		/*
		 * QSPI NOR W25Q64JVSSIQ (8 MB) on OSPI-B/XSPI0 channel 0, CS1.
		 * DISABLED: Zephyr 的 renesas,ra-ospi-b-nor 驱动只支持 Octal
		 * XSPI 模式 (按 Cypress S28HL 系列写死), W25Q64 为标准 Quad
		 * NOR, init 时报 "XSPI mode DUAL|QUAD currently not support"
		 * 后优雅失败. 需驱动扩展 Quad 支持后才能打开.
		 * 引脚: SCK=P808 SIO0=P100 SIO1=P803 SIO2=P103 SIO3=P101 CS1=P104.
		 */
		ospi0: ospi@40268000 {
			compatible = "renesas,ra-ospi-b";
			reg = <0x40268000 0x19c>;
			#address-cells = <1>;
			#size-cells = <1>;
			clocks = <&octaspiclk MSTPB 16>;
			pinctrl-0 = <&ospi0_default>;
			pinctrl-names = "default";
			status = "disabled";

			/* W25Q64JVSSIQ on CS1, memory mapped at 0x90000000 */
			w25q64: flash@90000000 {
				compatible = "renesas,ra-ospi-b-nor";
				reg = <0x90000000 DT_SIZE_M(8)>;
				protocol-mode = <XSPI_QUAD_MODE>;
				data-rate = <XSPI_STR_TRANSFER>;
				ospi-max-frequency = <DT_FREQ_M(50)>;
				write-block-size = <1>;
				status = "disabled";

				pages_layout: pages_layout {
					pages_layout_4k: pages_layout_4k {
						pages-count = <2048>;
						pages-size = <DT_SIZE_K(4)>;
					};
				};
			};
		};
	};

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &code_mram_cm85;
		zephyr,flash-controller = &mram_ctrl;
		zephyr,console = &uart1;
		zephyr,shell-uart = &uart1;
		zephyr,entropy = &trng;
		zephyr,display = &lcdif;
	};

	aliases {
		led0 = &led_g;
		led1 = &led_r;
		led2 = &led_b;
		sw0 = &button_sw2;
	};

	sdram0: sdram@68000000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		device_type = "memory";
		reg = <0x68000000 DT_SIZE_M(24)>;
		zephyr,memory-region = "SDRAM";
		status = "okay";
	};

	/* GLCDC 帧缓冲专用 (SDRAM 后 8MB): NOCACHE 保证 DMA 可见,
	 * 官方固件同款 .sdram_noinit_nocache 方案 */
	sdram_fb: sdram-fb@68800000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		device_type = "memory";
		reg = <0x68800000 DT_SIZE_M(8)>;
		zephyr,memory-region = "SDRAM_FB";
		zephyr,memory-attr = <(DT_MEM_ARM(ATTR_MPU_RAM_NOCACHE))>;
		status = "okay";
	};

	buttons {
		compatible = "gpio-keys";

		/* USER/BOOT button SW2 on P201/MD (IRQ4), press = low */
		button_sw2: sw2 {
			gpios = <&ioport2 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "User Button SW2";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_g: led_g {
			gpios = <&ioport1 8 GPIO_ACTIVE_LOW>;
			label = "User LED G";
		};

		led_r: led_r {
			gpios = <&ioport1 9 GPIO_ACTIVE_LOW>;
			label = "User LED R";
		};

		led_b: led_b {
			gpios = <&ioport1 10 GPIO_ACTIVE_LOW>;
			label = "User LED B";
		};
	};
};

/* 24 MHz main crystal on EXTAL/XTAL */
&xtal {
	clock-frequency = <DT_FREQ_M(24)>;
	mosel = <0>;
	#clock-cells = <0>;
	status = "okay";
};

&pll {
	status = "okay";

	pllp: pllp {
		status = "okay";
	};

	pllq: pllq {
		status = "okay";
	};

	pllr: pllr {
		status = "okay";
	};
};

&pll2 {
	clocks = <&xtal>;
	div = <3>;
	mul = <300 0>;
	status = "okay";

	pll2p {
		div = <4>;
		freq = <DT_FREQ_M(600)>;
		status = "okay";
	};

	pll2q {
		div = <3>;
		freq = <DT_FREQ_M(800)>;
		status = "okay";
	};

	pll2r {
		div = <5>;
		freq = <DT_FREQ_M(480)>;
		status = "okay";
	};
};

&sciclk {
	clocks = <&pll2r>;
	div = <4>;
	status = "okay";
};

/* 600 MHz / 10 = 60 MHz OSPI input clock */
&octaspiclk {
	clocks = <&pll2p>;
	div = <10>;
	status = "okay";
};

&uclk {
	clocks = <&pll2r>;
	div = <10>;
	status = "okay";
};

/* Ethernet switch clocks (同 ek_ra8p1: 250M/500M/25M) */
&eswclk {
	clocks = <&pllp>;
	div = <4>;
	status = "okay";
};

&eswphyclk {
	clocks = <&pllp>;
	div = <2>;
	status = "okay";
};

&ethphyclk {
	clocks = <&pllr>;
	div = <16>;
	status = "okay";
};

&trng {
	status = "okay";
};

/* GLCDC 时钟: pll2r/4 = 120 MHz (官方 BSP 同款时钟源), /2 = 60 MHz 像素时钟 */
&lcdclk {
	clocks = <&pll2r>;
	div = <4>;
	status = "okay";
};

&ioport0 {
	status = "okay";
};

&ioport1 {
	status = "okay";
};

&ioport4 {
	status = "okay";

	/* 上电即按住 GT911 复位: 防止其僵尸态锁死 I2C 总线导致启动卡死白屏
	 * (gt911 驱动初始化时再接管此脚做正规复位脉冲) */
	touch-rst-hog {
		gpio-hog;
		gpios = <12 GPIO_ACTIVE_LOW>;
		output-low;
		line-name = "CTP_RST";
	};
};

&ioportb {
	status = "okay";
};

&ioport3 {
	status = "okay";
};

&ioport9 {
	status = "okay";
};

&ioporta {
	status = "okay";
};

&ioportc {
	status = "okay";
};

&ioport5 {
	status = "okay";
};

&ioportd {
	status = "okay";
};

&ioport2 {
	status = "okay";
	port-irqs = <&port_irq4>;
	port-irq-names = "port-irq4";
	port-irq4-pins = <1>; /* P201 */
};

/* SW2 on P201, NVIC slot 8 (0-3: sci2, 4-7: sci1) */
&port_irq4 {
	interrupts = <8 12>;
	status = "okay";
};

&ioport7 {
	status = "okay";
};

&ioport8 {
	status = "okay";
};

/* Debug UART on U18 (RPi 40-pin header, pin 8=TXD1/P707, pin 10=RXD1/P706) */
&sci1 {
	pinctrl-0 = <&sci1_default>;
	pinctrl-names = "default";
	interrupts = <4 1>, <5 1>, <6 1>, <7 1>;
	interrupt-names = "rxi", "txi", "tei", "eri";
	status = "okay";

	uart1: uart {
		current-speed = <115200>;
		status = "okay";
	};
};

/* Secondary UART on H1 (1=GND, 2=RXD2, 3=TXD2) */
&sci2 {
	pinctrl-0 = <&sci2_default>;
	pinctrl-names = "default";
	interrupts = <0 1>, <1 1>, <2 1>, <3 1>;
	interrupt-names = "rxi", "txi", "tei", "eri";
	status = "okay";

	uart2: uart {
		current-speed = <115200>;
		status = "okay";
	};
};

/* SD card slot (SDHI0, 4-bit, card-detect on PD07) */
&sdhc0 {
	pinctrl-0 = <&sdhc0_default>;
	pinctrl-names = "default";
	interrupts = <9 12>, <10 12>, <11 12>;
	interrupt-names = "accs", "card", "dma-req";
	status = "okay";

	sdmmc {
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
		status = "okay";
	};
};

/* IMU 总线 IIC1 (NVIC 12-15: 0-3 sci2, 4-7 sci1, 8 irq4, 9-11 sdhc0) */
&iic1 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&iic1_default>;
	pinctrl-names = "default";
	interrupts = <12 1>, <13 1>, <14 1>, <15 1>;
	interrupt-names = "rxi", "txi", "tei", "eri";
	status = "okay";

	/* LSM6DS3TR-C: WHO_AM_I 0x6A 与 LSM6DSL 相同, 寄存器兼容 */
	lsm6ds3tr_c: imu@6a {
		compatible = "st,lsm6dsl";
		reg = <0x6a>;
		status = "okay";
	};
};

/* SDRAM W9825G6KH-6: 32MB 16-bit, CL=3, 时序同 ek_ra8p1 (兼容 -6 级颗粒) */
&sdram {
	pinctrl-0 = <&sdram_default>;
	pinctrl-names = "default";
	status = "okay";
	auto-refresh-interval = <SDRAM_AUTO_REFRESH_INTERVAL_10CYCLES>;
	auto-refresh-count = <SDRAM_AUTO_REFRESH_COUNT_8TIMES>;
	precharge-cycle-count = <SDRAM_AUTO_PRECHARGE_CYCLE_3CYCLES>;
	multiplex-addr-shift = "9-bit";
	endian-mode = "little-endian";
	continuous-access;
	bus-width = "16-bit";

	bank@0 {
		reg = <0>;
		renesas,ra-sdram-timing = <SDRAM_TRAS_6CYCLES
					   SDRAM_TRCD_3CYCLES
					   SDRAM_TRP_3CYCLES
					   SDRAM_TWR_2CYCLES
					   SDRAM_TCL_3CYCLES
					   937
					   SDRAM_TREFW_8CYCLES>;
	};
};

/* Gigabit Ethernet: RTL8211F-CG on eth1/RGMII1 (NVIC 24 gwdi) */
&eswm {
	interrupts = <24 1>;
	interrupt-names = "gwdi";
	status = "okay";
};

&eth1 {
	phy-connection-type = "rgmii";
	/* RTL8211F strap 自带 RXC 2ns 延迟, 再叠 MAC TXCIDE 会错出千兆采样窗 */
	renesas,no-txc-delay;
	local-mac-address = [02 00 00 50 01 01];
	phy-clock-type = "xtal";
	phy-handle = <&rtl8211f>;
	pinctrl-0 = <&eth1_default>;
	pinctrl-names = "default";
	status = "okay";
};

/*
 * PHY 管理总线在 mdio0 (ET0_MDC/ET0_MDIO = PC11/PC12), 数据通路在 eth1
 * (RGMII1) — 板子原理图如此, mdio 驱动 init 会自行把 ETHA0 切到工作模式.
 */
&mdio0 {
	pinctrl-0 = <&mdio0_default>;
	pinctrl-names = "default";
	status = "okay";

	rtl8211f: phy@1 {
		compatible = "realtek,rtl8211f";
		reg = <1>;
		/* 驱动按裸极性写 set(0)/set(1), 须声明 ACTIVE_HIGH (同 NXP rtl8211f 板):
		 * set(0)=物理低=复位, set(1)=物理高=释放 */
		reset-gpios = <&ioporta 7 GPIO_ACTIVE_HIGH>; /* ET1_RESET PA07 */
		/* 千兆 RGMII DDR 时序待调, 先限 100M (时序调好后删除) */
		/* 无 int-gpios: PHY 驱动用周期轮询监测链路 (省 IRQ31) */
		status = "okay";
	};
};

/*
 * ATK-MD0700R-1024600 (EK79001): DE 模式时序, DCLK 50 MHz,
 * 帧缓冲放 SDRAM (双缓冲 2x1.2MB)
 */
&lcdif {
	pinctrl-0 = <&lcdif_default>;
	pinctrl-names = "default";
	interrupts = <20 0>;
	interrupt-names = "line";
	status = "okay";
	width = <1024>;
	height = <600>;
	input-pixel-format = <PANEL_PIXEL_FORMAT_RGB_565>;
	output-pixel-format = <PANEL_PIXEL_FORMAT_RGB_565>;
	output-clock-divisor = <2>;
	output-signal-sync-edge = "RISING";
	output-pin-hsync = "TCON_PIN_0";
	output-pin-vsync = "TCON_PIN_1";
	output-pin-de = "TCON_PIN_3";
	backlight-gpios = <&ioport3 3 GPIO_ACTIVE_HIGH>; /* LCD_BL P303 */
	ext-ram = <&sdram_fb>;

	display_timings: display_timings {
		compatible = "zephyr,panel-timing";
		hsync-len = <20>;
		hback-porch = <140>;
		hfront-porch = <160>;
		vsync-len = <3>;
		vback-porch = <20>;
		vfront-porch = <12>;
		hsync-active = <0>; /* ATK 模块 HSYNC/VSYNC 低有效 */
		vsync-active = <0>;
		de-active = <1>;
		pixelclk-active = <0>;
	};
};

/* 触摸 GT911 (NVIC 16-19: 0-3 sci2, 4-7 sci1, 8 irq4, 9-11 sdhc0, 12-15 iic1, 20 lcdif) */
&iic0 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <I2C_BITRATE_STANDARD>; /* 100k: FPC/转接线信号裕量 */
	pinctrl-0 = <&iic0_default>;
	pinctrl-names = "default";
	interrupts = <16 1>, <17 1>, <18 1>, <19 1>;
	interrupt-names = "rxi", "txi", "tei", "eri";
	status = "okay";

	gt911: gt911@5d {
		compatible = "goodix,gt911";
		reg = <0x5d>;
		alt-addr = <0x14>;
		irq-gpios = <&ioport0 7 GPIO_ACTIVE_LOW>;   /* CTP_IRQ_N P007 */
		reset-gpios = <&ioport4 12 GPIO_ACTIVE_LOW>; /* CTP_RST  P412 */
		status = "okay";
	};
};
