 *
 * Titan Mini board pinctrl (schematic: Titan_Mini HW V1.0)
 * Debug UART on U18 (RPi 40-pin): SCI1 TXD1 = P707, RXD1 = P706
 * Secondary UART on H1: SCI2 TXD2 = P801, RXD2 = P802
 */

#include <zephyr/dt-bindings/pinctrl/renesas/pinctrl-ra.h>

&pinctrl {
	sci1_default: sci1_default {
		group1 {
			/* tx */
			psels = <RA_PSEL(RA_PSEL_SCI_1, 7, 7)>;
			drive-strength = "medium";
		};

		group2 {
			/* rx */
			psels = <RA_PSEL(RA_PSEL_SCI_1, 7, 6)>;
		};
	};

	sci2_default: sci2_default {
		group1 {
			/* tx */
			psels = <RA_PSEL(RA_PSEL_SCI_2, 8, 1)>;
			drive-strength = "medium";
		};

		group2 {
			/* rx */
			psels = <RA_PSEL(RA_PSEL_SCI_2, 8, 2)>;
		};
	};

	sdhc0_default: sdhc0_default {
		group1 {
			psels = <RA_PSEL(RA_PSEL_SDHI, 13, 7)>, /* SDCD PD07 */
				<RA_PSEL(RA_PSEL_SDHI, 13, 4)>, /* SDCMD PD04 */
				<RA_PSEL(RA_PSEL_SDHI, 13, 3)>, /* SDDATA0 PD03 */
				<RA_PSEL(RA_PSEL_SDHI, 13, 2)>, /* SDDATA1 PD02 */
				<RA_PSEL(RA_PSEL_SDHI, 13, 1)>, /* SDDATA2 PD01 */
				<RA_PSEL(RA_PSEL_SDHI, 1, 11)>; /* SDDATA3 P111 */
			drive-strength = "high";
		};

		group2 {
			psels = <RA_PSEL(RA_PSEL_SDHI, 13, 5)>; /* SDCLK PD05 */
			drive-strength = "highspeed-high";
		};
	};

	iic1_default: iic1_default {
		group1 {
			/* SCL1 SDA1 (板上 10K 上拉, IMU 总线) */
			psels = <RA_PSEL(RA_PSEL_I2C, 5, 12)>,
				<RA_PSEL(RA_PSEL_I2C, 5, 11)>;
			drive-strength = "medium";
		};
	};

	ospi0_default: ospi0_default {
		group1 {
			/* sclk sio0-3 (W25Q64JVSSIQ, quad) */
			psels = <RA_PSEL(RA_PSEL_OSPI, 8, 8)>, /* OM_0_SCLK P808 */
				<RA_PSEL(RA_PSEL_OSPI, 1, 0)>, /* OM_0_SIO0 P100 */
				<RA_PSEL(RA_PSEL_OSPI, 8, 3)>, /* OM_0_SIO1 P803 */
				<RA_PSEL(RA_PSEL_OSPI, 1, 3)>, /* OM_0_SIO2 P103 */
				<RA_PSEL(RA_PSEL_OSPI, 1, 1)>; /* OM_0_SIO3 P101 */
			drive-strength = "high";
		};

		group2 {
			/* cs1 */
			psels = <RA_PSEL(RA_PSEL_OSPI, 1, 4)>; /* OM_0_CS1 P104 */
			drive-strength = "high";
		};
	};
};
