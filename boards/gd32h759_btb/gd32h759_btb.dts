/dts-v1/;

#include <gd/gd32h7xx/gd32h759xx.dtsi>
#include "gd32h759_btb-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/memory-attr/memory-attr.h>
#include <zephyr/dt-bindings/memory-attr/memory-attr-arm.h>

/ {
	model = "EmbedFire GD32H759IMK6 BTB Board";
	compatible = "embedfire,gd32h759-btb";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &usart0;
		zephyr,shell-uart = &usart0;
		zephyr,flash-controller = &fmc;
		zephyr,entropy = &trng;
	};

	leds {
		compatible = "gpio-leds";

		led1: led1 {
			gpios = <&gpiod 11 GPIO_ACTIVE_LOW>;
			label = "LED1";
		};

		led2: led2 {
			gpios = <&gpiof 7 GPIO_ACTIVE_LOW>;
			label = "LED2";
		};

		led3: led3 {
			gpios = <&gpiod 4 GPIO_ACTIVE_LOW>;
			label = "LED3";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		key1: key_1 {
			label = "KEY1";
			gpios = <&gpioa 0 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_0>;
		};

		key2: key_2 {
			label = "KEY2";
			gpios = <&gpiod 7 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_1>;
		};
	};

	aliases {
		led0 = &led1;
		swi0 = &led2;
	};
};

&gpioa {
	status = "okay";
};

&gpiob {
	status = "okay";
};

&gpioc {
	status = "okay";
};

&gpiod {
	status = "okay";
};

&gpioe {
	status = "okay";
};

&gpiof {
	status = "okay";
};

&gpiog {
	status = "okay";
};

&gpioh {
	status = "okay";
};

&dma0 {
	status = "okay";
};

&timer0 {
	/* TIMER0 is 16-bit: run the counter at CK_AHB/2/300 = 1MHz so that
	 * typical periods (up to ~65ms) fit in the counter. */
	prescaler = <299>;
	status = "okay";

	pwm {
		status = "okay";
		pinctrl-0 = <&timer0_default>;
		pinctrl-names = "default";
	};
};

&adc0 {
	status = "okay";
};

&can2 {
	status = "okay";
	pinctrl-0 = <&can2_default>;
	pinctrl-names = "default";
	bitrate = <1000000>;
	bitrate-data = <5000000>;

	/* SIT1042AQT CAN transceiver on J8 (R37 120-ohm jumper optional) */
	can-transceiver {
		max-bitrate = <5000000>;
	};
};

/* on-board GD25Q64ESIGR NOR flash (U7, 8MB) on OSPI0 port 0 */
&ospi0 {
	status = "okay";
	pinctrl-0 = <&ospi0_default>;
	pinctrl-names = "default";
	size = <0x800000>;
	jedec-id = [c8 40 17];
};

/* LAN8720A RMII PHY (U3, 10/100M).  The 50MHz reference clock comes from
 * CK_OUT0 (PA8) into the PHY CLKIN, REF_CLK returns on PA1; PF6 resets
 * the PHY (10K pullup, active low). */
&eth0 {
	status = "okay";
	pinctrl-0 = <&eth0_default>;
	pinctrl-names = "default";
	local-mac-address = [02 0e 1f 75 90 01];
	phy-reset-gpios = <&gpiof 6 GPIO_ACTIVE_LOW>;
};

&trng {
	status = "okay";
};

/ {
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;

		/* OSPI0 memory-mapped read window (quad fast read): direct
		 * pointer reads only, erase/program stay indirect. Kept
		 * non-cacheable: the OSPI AHB slave hangs on the D-cache
		 * line-fill (wrapping burst) reads a cacheable attribute
		 * would generate. */
		ospi0_mm: ospi0-mm@90000000 {
			compatible = "zephyr,memory-region";
			reg = <0x90000000 0x800000>;
			zephyr,memory-region = "OSPI0_MM";
			zephyr,memory-attr = <(DT_MEM_ARM(ATTR_MPU_RAM_NOCACHE) | DT_MEM_NON_VOLATILE)>;
		};
	};
};

&usart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&usart0_default>;
	pinctrl-names = "default";
};
