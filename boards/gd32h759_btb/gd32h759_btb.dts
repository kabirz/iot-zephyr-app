/dts-v1/;

#include <gd/gd32h7xx/gd32h759xx.dtsi>
#include "gd32h759_btb-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "EmbedFire GD32H759IMK6 BTB Board";
	compatible = "embedfire,gd32h759-btb";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &usart0;
		zephyr,shell-uart = &usart0;
		zephyr,flash-controller = &fmc;
	};

	leds {
		compatible = "gpio-leds";

		led1: led1 {
			gpios = <&gpiod 11 GPIO_ACTIVE_LOW>;
			label = "LED1";
		};

		led2: led2 {
			gpios = <&gpiof 7 GPIO_ACTIVE_LOW>;
			label = "LED2";
		};

		led3: led3 {
			gpios = <&gpiod 4 GPIO_ACTIVE_LOW>;
			label = "LED3";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		key1: key_1 {
			label = "KEY1";
			gpios = <&gpioa 0 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_0>;
		};

		key2: key_2 {
			label = "KEY2";
			gpios = <&gpiod 7 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_1>;
		};
	};

	aliases {
		led0 = &led1;
		swi0 = &led2;
	};
};

&gpioa {
	status = "okay";
};

&gpiob {
	status = "okay";
};

&gpioc {
	status = "okay";
};

&gpiod {
	status = "okay";
};

&gpioe {
	status = "okay";
};

&gpiof {
	status = "okay";
};

&gpiog {
	status = "okay";
};

&gpioh {
	status = "okay";
};

&dma0 {
	status = "okay";
};

&timer0 {
	/* TIMER0 is 16-bit: run the counter at CK_AHB/2/300 = 1MHz so that
	 * typical periods (up to ~65ms) fit in the counter. */
	prescaler = <299>;
	status = "okay";

	pwm {
		status = "okay";
		pinctrl-0 = <&timer0_default>;
		pinctrl-names = "default";
	};
};

&usart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&usart0_default>;
	pinctrl-names = "default";
};
