# Cortex-M7 has MPU: enable hardware stack overflow protection
CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

# UART + console (USART0 PA9/PA10 on the J13 debug header)
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# GPIO (LEDs/keys)
CONFIG_GPIO=y

CONFIG_PINCTRL=y
