# Cortex-M7 has MPU: enable hardware stack overflow protection
CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

# UART + console (USART0 PA9/PA10 on the J13 debug header)
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# GPIO (LEDs/keys)
CONFIG_GPIO=y

CONFIG_PINCTRL=y

# On-board peripherals (flash0/ospi0-flash/dma0/timer0-pwm/adc0/can2 enabled in the board dts)
CONFIG_FLASH=y
CONFIG_FLASH_GD32_OSPI=y
CONFIG_DMA=y
CONFIG_PWM=y
CONFIG_ADC=y
CONFIG_CAN=y
