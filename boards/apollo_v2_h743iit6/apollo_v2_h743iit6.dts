/*
 * 阿波罗 V2 STM32H743 开发板 (正点原子 Alientek)
 *   核心板: STM32H743_CORE V2.0 (STM32H743IIT6, LQFP176, 480MHz, 2MB Flash / 1MB RAM)
 *   底板:   DNF429P_F767P_H743P V2.5
 *
 * 板 DTS 包含板载固定硬件 (引脚经 apps/examples/hw-bringup 实测验证):
 *   - 25MHz HSE -> PLL 480MHz 时钟
 *   - USART1 控制台 (PA9/PA10, 经 CH340C)
 *   - LED / 按键 / 底板 I2C2 (PH4/PH5) + 24C02 + PCF8574
 *   - 以太网 MAC + YT8512C PHY (RMII)
 *   - QSPI W25Q256 32MB / FMC SDRAM W9825G6KH 32MB
 *   - ADC1(PA5) / DAC1(PA4) / PWM TIM2_CH4(PA3) / SDMMC1 TF 卡 / RTC(LSE)
 *
 * 与其他外设冲突的引脚 (P9 = USB/CAN 二选一; USART2/3 与 RMII 冲突) 不在
 * 板级默认使能, 由应用 overlay 决定。引脚分配见
 * docs/Apollo_V2_STM32H743_Hardware_Config.md
 */

/dts-v1/;
#include <st/h7/stm32h743Xi.dtsi>
#include <st/h7/stm32h743iitx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/memory-controller/stm32-fmc-nor-psram.h>
#include <zephyr/dt-bindings/memory-attr/memory-attr.h>
#include <zephyr/dt-bindings/display/panel.h>

/ {
	model = "Alientek Apollo V2 STM32H743IIT6";
	compatible = "st,stm32h743iit6", "st,stm32h743";

	chosen {
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,display = &lcd_ili9341;
		zephyr,touch = &touch_xpt2046;
		zephyr,sram = &sram0;
		zephyr,dtcm = &dtcm;
		zephyr,flash = &flash0;
		/* MCUboot 布局: 应用链入内部 slot0 (mcuboot 域构建时该 chosen
		 * 被忽略, MCUboot 本体仍在 0x08000000) */
		zephyr,code-partition = &slot0_partition;
	};

	/* FMC SDRAM bank1 内存区 (32MB, 控制器配置见 &fmc) */
	sdram_mem: sdram@c0000000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		device_type = "memory";
		reg = <0xc0000000 DT_SIZE_M(32)>;
		zephyr,memory-region = "SDRAM";
	};

	/* TFTLCD 所在的 FMC NE1 区: Cortex-M7 默认映射下该区可缓存,
	 * LCD 写会滞留 D-Cache (屏收不到数据)。声明为 MPU IO 属性
	 * (Device 非共享), ARM MPU 驱动启动时静态建立 region —— 注意
	 * 不能用运行时手动配 MPU 的方式, 栈保护会在上下文切换时清掉
	 * 动态区 (见 apps/examples/hw-bringup/src/lcd_fmc.c 注释) */
	lcd_mem: memory@60000000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x60000000 DT_SIZE_M(64)>;
		zephyr,memory-region = "LCD";	/* 仅 linker 声明, 不放置段 */
		zephyr,memory-attr = <DT_MEM_ARM_MPU_IO>;
	};

/* ============ 电阻触摸 XPT2046 (TFTLCD 排座, 5 线 GPIO 位拆 SPI) ============
 * T_CLK=PH6  T_DIN=PI3  T_DO=PG3  T_CS=PI8  T_PEN(中断)=PH7
 * 引脚分散无硬件 SPI 覆盖, 使用 zephyr bitbang SPI 控制器 */
touch_spi: touch-spi {
	compatible = "zephyr,spi-bitbang";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	clk-gpios = <&gpioh 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
	mosi-gpios = <&gpioi 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
	miso-gpios = <&gpiog 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
	cs-gpios = <&gpioi 8 GPIO_ACTIVE_LOW>;

	touch_xpt2046: xpt2046@0 {
		compatible = "xptek,xpt2046";
		reg = <0>;
		spi-max-frequency = <100000>;
		int-gpios = <&gpioh 7 GPIO_ACTIVE_LOW>;	/* T_PEN, 按下拉低 */
		touchscreen-size-x = <240>;
		touchscreen-size-y = <320>;
		/* 原始 12 位 ADC 校准边界, 按实测微调 */
		min-x = <200>;
		max-x = <3900>;
		min-y = <200>;
		max-y = <3900>;
		z-threshold = <300>;
		reads = <8>;
	};
};

	/* 阿波罗 V2 LED 低电平点亮 (V1 实测, 见应用计划 §10.2 修复 #3) */
	leds {
		compatible = "gpio-leds";

		red_led: led_0 {	/* DS0 红, 核心板 PB1 */
			gpios = <&gpiob 1 GPIO_ACTIVE_LOW>;
			label = "DS0 Red";
		};
		green_led: led_1 {	/* DS1 绿, 底板 PB0 */
			gpios = <&gpiob 0 GPIO_ACTIVE_LOW>;
			label = "DS1 Green";
		};

		/* TFTLCD 背光 PB5, 高电平点亮 (正点原子阿波罗 V2) */
		lcd_bl: lcd-backlight {
			gpios = <&gpiob 5 GPIO_ACTIVE_HIGH>;
			label = "LCD Backlight";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		key_up: button_0 {	/* WK_UP, 按下接 3.3V, 可做待机唤醒 */
			label = "KEY_UP";
			gpios = <&gpioa 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			zephyr,code = <INPUT_KEY_0>;
		};
		key_0: button_1 {	/* KEY0, 按下接地 */
			label = "KEY0";
			gpios = <&gpioh 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_1>;
		};
		key_1: button_2 {	/* KEY1, 按下接地 */
			label = "KEY1";
			gpios = <&gpioh 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_2>;
		};
		key_2: button_3 {	/* KEY2, 按下接地 */
			label = "KEY2";
			gpios = <&gpioc 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_3>;
		};
	};

	aliases {
		led0 = &red_led;
		led1 = &green_led;
		sw0 = &key_up;
		sw1 = &key_0;
		sw2 = &key_1;
		sw3 = &key_2;
		watchdog0 = &iwdg;
		sram-ext = &sdram_mem;
	};
};

/* 25MHz 主晶振 (PH0/PH1) */
&clk_hse {
	clock-frequency = <DT_FREQ_M(25)>;
	status = "okay";
};

/* ============ MCUboot Flash 分区 (跨 Flash: 内部 slot0 + QSPI slot1) ============
 * 布局 (实测教训: slot0 不得跨 H7 双 bank!):
 *   - MCUboot 常驻 bank1 前部 (0x08000000, 256KB = 2 扇区)
 *   - slot0 完全落在 bank2 (0x08100000, 1MB = 8 扇区): H7 仅支持跨 bank
 *     读写 (RWW), swap 擦除 slot0 时 MCUboot 在 bank1 取指不受影响;
 *     slot0 横跨 bank1 时 swap 擦除会卡死取指总线 (实测死锁)
 *   - 升级镜像落 QSPI slot1 (与 slot0 等大), SWAP_SCRATCH 交换 */
&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 0x00040000>;	/* 256KB = bank1 扇区 0-1 */
			read-only;
		};

		slot0_partition: partition@100000 {
			label = "slot0";
			reg = <0x00100000 0x00100000>;	/* 1MB = bank2 整体 (8 扇区) */
		};
	};
};

/* PLL: 25MHz / 5(M) = 5MHz * 192(N) = 960MHz; / 2(P) = 480MHz SYSCLK,
 * / 20(Q) = 48MHz 供 USB OTG FS (暂未使能, 预先分好) */
&pll {
	div-m = <5>;
	mul-n = <192>;
	div-p = <2>;
	div-q = <20>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(480)>;	/* D1CCLK = 480MHz */
	d1cpre = <1>;		/* Cortex-M7 480MHz */
	hpre = <2>;		/* AHB 240MHz */
	d1ppre = <2>;		/* APB3 120MHz */
	d2ppre1 = <2>;		/* APB1 120MHz */
	d2ppre2 = <2>;		/* APB2 120MHz */
	d3ppre = <2>;		/* APB4 120MHz */
};

&pwr {
	power-supply = "ldo";
};

&clk_hsi48 {
	status = "okay";
};

&rng {
	status = "okay";
};

/* USART1 (PA9/PA10), 经底板 CH340C 接 USB_232 Type-C (P11 跳线需短接) */
&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/* 底板 I2C 总线 (PH4=SCL/PH5=SDA): 24C02/PCF8574/SH3001/ST480MC/AP3216C/ES8388 */
&i2c2 {
	pinctrl-0 = <&i2c2_scl_ph4 &i2c2_sda_ph5>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";

	/* PCF8574T IO 扩展 @0x20:
	 * P0=BEEP  P1=AP_INT  P2=DCMI_PWDN  P3=USB_PWR
	 * P4=EXIO  P5=6D_INT  P6=RS485_RE   P7=ETH_RESET (低有效)
	 * 注意: 输出状态跨 SWD 复位保持; BEEP 实测 P0 低 = 响 */
	exio: pcf8574@20 {
		compatible = "nxp,pcf857x";
		reg = <0x20>;
		status = "okay";
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <8>;
	};

	/* 24C02 EEPROM, 256B / 页 8B */
	eeprom_24c02: eeprom@50 {
		compatible = "atmel,at24";
		reg = <0x50>;
		size = <256>;
		pagesize = <8>;
		address-width = <8>;
		timeout = <10>;
		status = "okay";
	};
};

/* 以太网: YT8512C PHY (RMII), PHY 输出 50MHz 参考时钟至 PA1 */
&mac {
	status = "okay";
	pinctrl-0 = <&eth_ref_clk_pa1
		     &eth_crs_dv_pa7
		     &eth_rxd0_pc4
		     &eth_rxd1_pc5
		     &eth_tx_en_pb11
		     &eth_txd0_pg13
		     &eth_txd1_pg14>;
	pinctrl-names = "default";
	phy-connection-type = "rmii";
	phy-handle = <&eth_phy>;
};

&mdio {
	status = "okay";
	pinctrl-0 = <&eth_mdc_pc1 &eth_mdio_pa2>;
	pinctrl-names = "default";

	eth_phy: ethernet-phy@0 {
		compatible = "motorcomm,yt8512";
		reg = <0x00>;
		/* PHY 复位脚在 PCF8574 P7 (低有效) */
		reset-gpios = <&exio 7 GPIO_ACTIVE_LOW>;
		reset-assert-duration-us = <10000>;
		reset-deassertion-timeout-ms = <100>;
	};
};

/* ============ QSPI W25Q256 32MB (PB2/PB6/PF6~PF9) ============
 * writeoc 必须显式指定 1-1-4 页编程 (0x32): 驱动默认用 1-4-4 (0x38),
 * W25Q256 不支持, 写会静默失效 (实测)。 */
&quadspi {
	pinctrl-0 = <&quadspi_clk_pb2
		     &quadspi_bk1_ncs_pb6
		     &quadspi_bk1_io0_pf8
		     &quadspi_bk1_io1_pf9
		     &quadspi_bk1_io2_pf7
		     &quadspi_bk1_io3_pf6>;
	pinctrl-names = "default";
	status = "okay";

	qspi_nor: qspi-nor-flash@0 {
		compatible = "st,stm32-qspi-nor";
		reg = <0>;
		size = <DT_SIZE_M(256)>;	/* 256 Mbit = 32 MB (单位: bit) */
		jedec-id = [ef 40 19];		/* Winbond W25Q256 */
		qspi-max-frequency = <40000000>;
		spi-bus-width = <4>;
		writeoc = "PP_1_1_4";
		status = "okay";

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/* MCUboot Secondary Slot: 与内部 slot0 等大 (swap 要求) */
			slot1_partition: partition@0 {
				label = "slot1";
				reg = <0x00000000 0x00100000>;	/* 1MB */
			};

			/* SWAP_SCRATCH 暂存: >= 内部 slot0 单扇区 128KB */
			scratch_partition: partition@100000 {
				label = "scratch";
				reg = <0x00100000 0x00040000>;	/* 256KB */
			};

			/* settings/配置区 (计划 §三, 暂未使用) */
			storage_partition: partition@140000 {
				label = "storage";
				reg = <0x00140000 0x00200000>;	/* 2MB */
			};

			/* Web 静态资源/字库区 (计划 §三, 暂未使用) */
			resources_partition: partition@340000 {
				label = "resources";
				reg = <0x00340000 0x00400000>;	/* 4MB */
			};

			/* 中文字库分区: GB2312 一级 3755 字 + ASCII 16px 4bpp,
			 * AF16 格式, 运行时经 QSPI memmap 直读 (0x90000000+0x740000) */
			font_partition: partition@740000 {
				label = "font";
				reg = <0x00740000 0x00400000>;	/* 4MB */
			};
		};
	};
};

/* ============ FMC SDRAM W9825G6KH 32MB (16 位) ============
 * 实测要点:
 *  - BA0/BA1 接 PG4/PG5 (FMC_A14/A15), 漏配则只有 BA=11 的 bank (高 8MB) 可用
 *  - SDNE0/SDCKE0 走 PC2/PC3 (_c 复用位), 与常见 H7 板 (PH2/PH3) 不同
 *  - 120MHz/CL3 实测信号不稳 (44% 错误), 定为 80MHz (HCLK/3) / CL2 */
&fmc {
	pinctrl-0 = <&fmc_nbl0_pe0 &fmc_nbl1_pe1
		     &fmc_sdclk_pg8 &fmc_sdnwe_pc0
		     &fmc_sdcke0_pc3_c &fmc_sdne0_pc2_c
		     &fmc_sdnras_pf11 &fmc_sdncas_pg15
		     &fmc_a0_pf0 &fmc_a1_pf1 &fmc_a2_pf2 &fmc_a3_pf3
		     &fmc_a4_pf4 &fmc_a5_pf5 &fmc_a6_pf12 &fmc_a7_pf13
		     &fmc_a8_pf14 &fmc_a9_pf15 &fmc_a10_pg0
		     &fmc_a11_pg1 &fmc_a12_pg2
		     &fmc_a14_pg4 &fmc_a15_pg5
		     &fmc_d0_pd14 &fmc_d1_pd15 &fmc_d2_pd0 &fmc_d3_pd1
		     &fmc_d4_pe7 &fmc_d5_pe8 &fmc_d6_pe9 &fmc_d7_pe10
		     &fmc_d8_pe11 &fmc_d9_pe12 &fmc_d10_pe13 &fmc_d11_pe14
		     &fmc_d12_pe15 &fmc_d13_pd8 &fmc_d14_pd9 &fmc_d15_pd10
		     /* TFTLCD (FMC 8080): CS=NE1(PD7) RS=A18(PD13) WR/NOE(PD4/PD5),
		      * 数据线 D0~D15 与 SDRAM 共享总线 */
		     &fmc_ne1_pd7 &fmc_a18_pd13
		     &fmc_nwe_pd5 &fmc_noe_pd4>;

	pinctrl-names = "default";
	status = "okay";

	sdram {
		status = "okay";
		power-up-delay = <200>;
		num-auto-refresh = <8>;
		/* CL=2, 突发长度 1, 写突发单点 */
		mode-register = <0x220>;
		/* W9825: 64ms/8192 行 = 7.81us 刷新间隔; sdclk=80MHz 对应
		 * ~625 周期, 取保守值 (更频繁刷新无害) */
		refresh-rate = <640>;

		bank@0 {
			reg = <0>;
			st,sdram-control = <STM32_FMC_SDRAM_NC_9
					    STM32_FMC_SDRAM_NR_13
					    STM32_FMC_SDRAM_MWID_16
					    STM32_FMC_SDRAM_NB_4
					    STM32_FMC_SDRAM_CAS_2
					    STM32_FMC_SDRAM_SDCLK_PERIOD_3
					    STM32_FMC_SDRAM_RBURST_ENABLE
					    STM32_FMC_SDRAM_RPIPE_1>;
			st,sdram-timing = <3 8 5 8 4 3 3>;
		};
	};

	/* TFTLCD 模块 (FMC 8080 16 位, NE1 @0x60000000, RS=A18):
	 * 慢时序保证 ILI9341/NT35510 的 ID 读回可靠 */
	nor_psram: nor-psram {
		compatible = "st,stm32-fmc-nor-psram";
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		lcd_bank: sram@0 {
			reg = <0>;	/* NE1 */
			st,control = <STM32_FMC_DATA_ADDRESS_MUX_DISABLE
				      STM32_FMC_MEMORY_TYPE_SRAM
				      STM32_FMC_NORSRAM_MEM_BUS_WIDTH_16
				      STM32_FMC_BURST_ACCESS_MODE_DISABLE
				      STM32_FMC_WAIT_SIGNAL_POLARITY_LOW
				      STM32_FMC_WAIT_TIMING_BEFORE_WS
				      STM32_FMC_WRITE_OPERATION_ENABLE
				      STM32_FMC_WAIT_SIGNAL_DISABLE
				      STM32_FMC_EXTENDED_MODE_DISABLE
				      STM32_FMC_ASYNCHRONOUS_WAIT_DISABLE
				      STM32_FMC_WRITE_BURST_DISABLE
				      STM32_FMC_CONTINUOUS_CLOCK_SYNC_ONLY
				      STM32_FMC_WRITE_FIFO_DISABLE
				      STM32_FMC_PAGE_SIZE_NONE>;
			st,timing = <15 3 100 15 2 2 STM32_FMC_ACCESS_MODE_A>;

			/* TFTLCD 总线抽象 (MIPI DBI Type B / Intel 8080 16 位):
			 * RS=register-select-pin=18 -> 数据口 0x60080000
			 * 背光独立接 PB5 (见应用侧), 复位接系统复位, 无需 GPIO */
			fmc_mipi_dbi: fmc-mipi-dbi {
				compatible = "st,stm32-fmc-mipi-dbi";
				bank-address = <0x60000000>;	/* NE1, 绕过 fork 缺失的 FMC_BANK1_x 宏 */
				register-select-pin = <18>;
				#address-cells = <1>;
				#size-cells = <0>;

				lcd_ili9341: lcd-panel@0 {
					compatible = "ilitek,ili9341";
					reg = <0>;
					mipi-mode = "MIPI_DBI_MODE_8080_BUS_16_BIT";
					mipi-max-frequency = <15000000>;
					width = <240>;
					height = <320>;
					pixel-format = <PANEL_PIXEL_FORMAT_RGB_565>;
					rotation = <0>;
					h-mirror;	/* 实测此模块需要 MX 位, 否则左右镜像 */
				};
			};
		};
	};
};

/* ============ ADC1 PA5 (INP19, TPAD/STM_ADC, P10 跳线) ============ */
&adc1 {
	pinctrl-0 = <&adc1_inp19_pa5>;
	pinctrl-names = "default";
	st,adc-clock-source = "SYNC";
	st,adc-prescaler = <4>;
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;

	pa5_adc: channel@19 {
		reg = <19>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
		zephyr,vref-mv = <3300>;
	};
};

/* ============ DAC1_OUT1 PA4 ============ */
&dac1 {
	pinctrl-0 = <&dac1_out1_pa4>;
	pinctrl-names = "default";
	status = "okay";
};

/* ============ PWM PA3 = TIM2_CH4 (PWM_DAC 输出, P1 排针) ============ */
&timers2 {
	st,prescaler = <240>;	/* 240MHz 计数时钟 / 240 = 1MHz */
	status = "okay";

	pwm2: pwm {
		status = "okay";
		pinctrl-0 = <&tim2_ch4_pa3>;
		pinctrl-names = "default";
	};
};

/* ============ SDMMC1 TF 卡 (4 位) ============
 * 注意: 不加 idma (IT 模式)。本 fork 驱动 idma 路径按 32 字节缓存行做
 * flush/invalidate, FATFS 内部 win[] 缓冲无对齐保证, 实测读到随机数据
 * (MBR 签名时有时无 -> 挂载 -19)。IT 模式读取稳定 (hw-bringup 实测);
 * V1 计划 §10.2 修复 #1 的 idma 待高负载写场景时重新评估 */
&sdmmc1 {
	status = "okay";
	disk-name = "SD";
	pinctrl-0 = <&sdmmc1_d0_pc8 &sdmmc1_d1_pc9
		     &sdmmc1_d2_pc10 &sdmmc1_d3_pc11
		     &sdmmc1_ck_pc12 &sdmmc1_cmd_pd2>;
	pinctrl-names = "default";
	bus-width = <4>;
};


/* ============ RTC, 32.768kHz LSE (PC14/PC15) ============ */
&clk_lse {
	status = "okay";
};

&rtc {
	clocks = <&rcc STM32_CLOCK(APB1, 28)>,
		 <&rcc STM32_SRC_LSE RTC_SEL(1)>;
	status = "okay";
};

/* LCD 控制脚照抄 ATK 配置: 上拉 + 高速输出级 (低速时排线上边沿过缓,
 * 悬浮读会回显最后写入值) */
&fmc_ne1_pd7 { slew-rate = "very-high-speed"; bias-pull-up; };
&fmc_a18_pd13 { slew-rate = "very-high-speed"; bias-pull-up; };
&fmc_nwe_pd5 { slew-rate = "very-high-speed"; bias-pull-up; };
&fmc_noe_pd4 { slew-rate = "very-high-speed"; bias-pull-up; };
